    {
      "id": "natura_2000",
      "nom": "Contrats Natura 2000",
      "type": "contrat_etat",
      "description": "Financement à 100% des actions de préservation et restauration de milieux pour les parcelles situées dans une zone Natura 2000. Contrat signé avec l'État pour 5 ans.",
      "montant": {
        "type": "pourcentage",
        "min_pct": 80,
        "max_pct": 100,
        "description": "Financement quasi-total des actions de restauration"
      },
      "duree_engagement": 5,
      "renouvelable": true,
      "cumulable_avec": ["defi_travaux"],
      "criteres_eligibilite": {
        "obligatoires": [
          {
            "id": "zone_natura_2000",
            "label": "Parcelle incluse dans un site Natura 2000",
            "champ_formulaire": "zone_natura_2000",
            "condition": "eq",
            "valeur": true
          },
          {
            "id": "action_preservation",
            "label": "Actions de préservation ou restauration de milieux naturels",
            "champ_formulaire": "action_preservation",
            "condition": "eq",
            "valeur": true
          }
        ]
      },
      "etapes_candidature": [
        "Vérifier l'inclusion de la parcelle sur inpn.mnhn.fr (carte interactive)",
        "Contacter la DDT (Direction Départementale des Territoires) locale",
        "Définir les actions avec l'animateur du site Natura 2000",
        "Signature du contrat avec l'État",
        "Réalisation des actions et suivi"
      ],
      "contact": "DDT locale — inpn.mnhn.fr pour vérifier la zone",
      "tags": ["biodiversite", "natura2000", "etat", "restauration"]
    }

  ],

  "regles_cumul": {
    "combinaison_optimale": {
      "label": "Combinaison maximale recommandée",
      "mecanismes": ["france_nation_verte", "feader", "defi_travaux", "lbc_reconstitution"],
      "description": "France Nation Verte + FEADER couvrent les travaux, DEFI Travaux réduit l'autofinancement restant, LBC génère des revenus sur 30 ans",
      "condition": "etat_peuplement IN [sinistre, depérissant] AND duree_propriete >= 30"
    },
    "incompatibilites": [
      {
        "mecanisme_1": "france_nation_verte",
        "mecanisme_2": "feader",
        "note": "Cumulables mais attention aux plafonds régionaux — vérifier avec CNPF local"
      }
    ]
  },

  "estimateur_carbone": {
    "description": "Estimation simplifiée de la séquestration carbone selon la surface",
    "tonne_co2_par_ha_par_an": {
      "feuillus": 4.5,
      "resineux": 6.0,
      "mixte": 5.0
    },
    "prix_credit_carbone_eur": {
      "min": 15,
      "max": 30,
      "moyen": 22
    },
    "formule": "surface_ha × tonne_co2_par_ha_par_an × prix_moyen × duree_ans"
  },

  "champs_formulaire": {
    "duree_propriete": {"type": "number", "label": "Depuis combien d'années êtes-vous propriétaire ?", "unite": "ans"},
    "surface_ha": {"type": "number", "label": "Surface de la parcelle", "unite": "hectares"},
    "etat_peuplement": {
      "type": "select",
      "label": "État actuel du peuplement forestier",
      "options": [
        {"valeur": "sinistre", "label": "Sinistré (incendie, tempête, scolytes — ≥20% mortalité)"},
        {"valeur": "depérissant", "label": "Dépérissant (≥20% d'arbres malades)"},
        {"valeur": "pauvre", "label": "Pauvre (faible productivité, peuplement dégradé)"},
        {"valeur": "vulnerable", "label": "Vulnérable au changement climatique"},
        {"valeur": "sain", "label": "Sain (bonne vitalité générale)"}
      ]
    },
    "type_peuplement": {
      "type": "select",
      "label": "Type de peuplement principal",
      "options": [
        {"valeur": "taillis_chene", "label": "Taillis de chênes"},
        {"valeur": "taillis_chataignier", "label": "Taillis de châtaigniers"},
        {"valeur": "futaie_resineuse", "label": "Futaie résineuse (épicéa, pin, douglas...)"},
        {"valeur": "futaie_feuillue", "label": "Futaie feuillue (hêtre, chêne, frêne...)"},
        {"valeur": "mixte", "label": "Peuplement mixte"},
        {"valeur": "non_boise", "label": "Terrain non boisé / friche"}
      ]
    },
    "non_boise_10ans": {"type": "boolean", "label": "Le terrain était-il non boisé il y a 10 ans ?"},
    "zone_natura_2000": {"type": "boolean", "label": "La parcelle est-elle dans une zone Natura 2000 ?"},
    "type_proprietaire": {
      "type": "select",
      "label": "Vous êtes",
      "options": [
        {"valeur": "prive", "label": "Propriétaire privé (particulier)"},
        {"valeur": "agriculteur", "label": "Agriculteur avec boisements"},
        {"valeur": "commune", "label": "Commune / collectivité"},
        {"valeur": "cooperative", "label": "Coopérative forestière"}
      ]
    },
    "region": {
      "type": "select",
      "label": "Région",
      "options": ["Normandie", "Bretagne", "Auvergne-Rhône-Alpes", "Occitanie", "Nouvelle-Aquitaine", "Grand-Est", "Île-de-France", "Bourgogne-Franche-Comté", "Hauts-de-France", "Pays-de-la-Loire", "Centre-Val-de-Loire", "Provence-Alpes-Côte-d'Azur", "Autre"]
    },
    "travaux_deja_commences": {"type": "boolean", "label": "Des travaux ont-ils déjà commencé sur la parcelle ?"}
  }
}
